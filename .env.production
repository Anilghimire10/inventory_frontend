# Absolute backend URL baked into the mobile build (npm run build:mobile).
#
# 10.0.2.2 is the Android EMULATOR's alias for your PC's localhost, so this
# default lets an emulator reach a locally-running NestJS API (port 3000).
#
# CHANGE THIS before shipping / testing on a real device:
#   - Real Android/iOS device on your LAN: http://<your-PC-LAN-IP>:3000/api
#   - Production:                          https://api.yourdomain.com/api
# Real device on same Wi-Fi as this PC (emulator would use http://10.0.2.2:3000/api):
NEXT_PUBLIC_API_URL=http://192.168.100.137:3000/api
