# Absolute backend URL baked into the mobile build (npm run build:mobile).
#
# 10.0.2.2 is the Android EMULATOR's alias for your PC's localhost, so a
# default of http://10.0.2.2:3000/api lets an emulator reach a locally-running
# NestJS API (port 3000).
#
# CHANGE THIS before building for a real device. Create a LOCAL override in
# .env.production.local (NOT committed) so this committed template stays safe:
#   - Real Android/iOS device on your LAN: http://<your-PC-LAN-IP>:3000/api
#   - Production:                          https://api.yourdomain.com/api
# Production backend on Render:
NEXT_PUBLIC_API_URL=https://inventory-backend-vlg7.onrender.com/api
