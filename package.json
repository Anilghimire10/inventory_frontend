{
  "name": "inventory-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 5173",
    "build": "next build",
    "start": "next start -p 5173",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:mobile": "cross-env BUILD_TARGET=mobile next build",
    "sync": "npm run build:mobile && cap sync",
    "sync:dev": "cross-env CAP_CLEARTEXT=true npm run sync",
    "android": "npm run sync && cap open android",
    "ios": "npm run sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/share": "^8.0.2",
    "@tanstack/react-query": "^5.59.0",
    "axios": "^1.7.7",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.446.0",
    "next": "^16.3.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^22.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vitest": "^5.0.1"
  }
}
