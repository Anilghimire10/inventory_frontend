# ── Web (dev / server) ────────────────────────────────────────────────
# Optional. Only set this if the backend API is NOT on http://localhost:3000.
# The web app proxies /api to this address (see next.config.mjs).
# For normal local dev (API on localhost:3000), leave this unset — no .env needed.
# Example for a remote API: API_URL=https://api.yourdomain.com
API_URL=

# ── Mobile (Capacitor static export) ──────────────────────────────────
# REQUIRED for the mobile build. There is no proxy inside the app, so the
# bundled JS must call an ABSOLUTE backend URL (include the /api suffix).
# Set this in .env.production (used by `npm run build:mobile`).
# Example: NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api
NEXT_PUBLIC_API_URL=
